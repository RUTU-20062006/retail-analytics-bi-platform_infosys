# OmniAnalytics Server Configuration
PORT=5000

# PostgreSQL Connection Settings
# Adjust these to match your local PostgreSQL or cloud provider (e.g., Supabase / Neon)
PGHOST=localhost
PGPORT=5432
PGDATABASE=omnianalytics
PGUSER=postgres
PGPASSWORD=your_postgres_password

# Or provide a single connection string:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/omnianalytics
